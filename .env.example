# Copia questo file in .env. Contiene SOLO valori non segreti: password e chiavi API stanno nella
# Gestione credenziali di Windows (vedi README, sezione "Sicurezza e credenziali"). NON committare mai .env.
DB_HOST=localhost
DB_NAME=boxoffice
DB_PORT=5432

# Ruoli PostgreSQL a privilegi minimi (creati da scripts/setup_db_roles.py)
# applicativo: pipeline, resolver, recupero (SELECT/INSERT/UPDATE, nessun DDL)
DB_USER=boxoffice_app
# migrazioni: l'unico ruolo con DDL (solo scripts/migrate.py)
DB_OWNER_USER=boxoffice_owner
# sola lettura: health check e analisi
DB_RO_USER=boxoffice_ro

# Opzionali
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30

# Solo per CI o override temporanei: in locale i segreti stanno nel deposito credenziali.
# Se presenti nell'ambiente hanno la precedenza sul deposito.
# DB_PASSWORD=
# TMDB_API_KEY=
# TMDB_READ_TOKEN=
